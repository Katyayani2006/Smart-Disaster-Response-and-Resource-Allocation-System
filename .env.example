# Copy this file to .env (or export these as real environment variables)
# to enable LIVE SMS/WhatsApp alerts. Without these, the app runs fine
# and SIMULATES alerts instead (printed to console + logged to
# data/alert_log.json) - useful for demos without a paid Twilio number.

# --- Existing app config -------------------------------------------------
ADMIN_API_KEY=your-long-random-secret-here
FLASK_SECRET_KEY=another-long-random-secret-here

# --- Twilio (SMS + WhatsApp) ---------------------------------------------
# 1. Create a free trial account at https://www.twilio.com/try-twilio
# 2. Copy your Account SID and Auth Token from the Twilio Console.
# 3. For SMS: buy/use a Twilio phone number as TWILIO_SMS_FROM.
# 4. For WhatsApp: use the Twilio Sandbox number for testing
#    (usually whatsapp:+14155238886) as TWILIO_WHATSAPP_FROM, after each
#    officer's phone joins the sandbox by sending the given join code.
TWILIO_ACCOUNT_SID=PASTE_YOUR_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=PASTE_YOUR_AUTH_TOKEN_HERE
TWILIO_SMS_FROM=+15017122661
# This is YOUR Twilio WhatsApp sandbox number from the "Try out WhatsApp" page.
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
